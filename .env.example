# Copy to .env.local and fill in. Never commit real values.

# Google AI Studio key (create it in a project with NO billing attached)
GEMINI_API_KEY=

# Groq key (free plan), used only when Gemini fails or runs out of quota
GROQ_API_KEY=

# Neon Postgres connection string (pooled URL is fine)
DATABASE_URL=

# Random string; Vercel Cron sends it as a Bearer token to the cleanup route
CRON_SECRET=
