# Copy to .env and fill in. Never commit real values.

# Google AI Studio key (create it in a project with NO billing attached)
GEMINI_API_KEY=

# Groq key (free plan), used only when Gemini fails or runs out of quota.
# Optional extra Groq keys GROQ_API_KEY_2, GROQ_API_KEY_3, ... are tried in order if the one before fails.
GROQ_API_KEY=

# Neon Postgres connection string (pooled URL is fine); used by the Python API
DATABASE_URL=

# Random string; Vercel Cron sends it as a Bearer token to the API cleanup route
CRON_SECRET=

